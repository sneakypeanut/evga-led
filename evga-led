#!/usr/bin/env python3
"""evga-led — control the onboard ARGB of an EVGA Z790 CLASSIFIED from Linux.

Reverse engineered from EVGA ELEET X1 1.0.16.0:
  Library/EDispNetLib.dll -> EDispNetLib.Hardwares.Z790.{Led,LEDUsbCommand,
                              LEDModeReport,LEDMainCommand,LEDSubCommand,LEDZone}

Transport: HID feature report ID 7 (225-byte payload / 226-byte buffer including
the report ID) on USB 3842:300e "EVGA 5516 MCU AP". Windows uses
HidD_SetFeature + HidD_GetFeature; the Linux equivalents are the
HIDIOCSFEATURE / HIDIOCGFEATURE ioctls on /dev/hidrawN.

Frame (Pack=1):
    [0]      7                     report id
    [1..2]   0xEA 0x02             header
    [3]      1                     main command (LightEffect)
    [4]      0 write / 1 read      sub command 1
    [5]      0                     sub command 2 (None)
    [6]      0xC0 success          response (filled by the device)
    [7]      checksum              two's complement of sum(bytes 0..6, 8..13)
    [8]      zone bitmask          1 ARGB1, 2 ARGB2, 4 ARGB3, 8 ARGB4,
                                  16 ARGB_COVER (= onboard "Z790|CLASSIFIED"), 31 all
    [9..13]  mode per zone         ARGB_1..ARGB_4, ARGB_COVER
    [14..225] reserved

Hardware quirks verified on this board (BIOS 1.20, Nov 2026):
  * A plain GET (no preceding SET) returns the MCU's last command frame and works.
  * After a SET, an immediate GET stalls with EPIPE — the command is applied
    anyway, so read-back is advisory only.
  * A SET on report ID 0 of the *other* interface (hidraw5) can wedge the LED
    interface until a USBDEVFS_RESET (0x5514) on the USB device.
  * LED state survives a USB reset and reboots while standby power is present.

Access: /dev/hidrawN is root-only. Install
    SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3842", ATTRS{idProduct}=="300e", TAG+="uaccess"
in /etc/udev/rules.d/, or let this script fall back to running itself inside a
container (docker group is root-equivalent, so no password prompt).
"""

from __future__ import annotations

import argparse
import errno
import fcntl
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

REPORT_ID = 0x07
HEADER1, HEADER2 = 0xEA, 0x02
BUFLEN = 226
MAIN_LIGHT_EFFECT = 1
SUB_WRITE, SUB_READ = 0, 1
RESPONSE = {0xC0: "Success", 0xC1: "Fail", 0xC2: "InProcess"}
VENDOR_PRODUCT = "00003842:0000300E"
DOCKER_IMAGE = os.environ.get("EVGA_LED_IMAGE", "python:3-slim")

ZONE_ORDER = [("argb1", 1), ("argb2", 2), ("argb3", 4), ("argb4", 8), ("cover", 16)]
ZONE_ALIASES = {"all": 31, "onboard": 16, "cover": 16}
for _n, _b in ZONE_ORDER:
    ZONE_ALIASES.setdefault(_n, _b)

MODES = {"off": 0, "on": 1, "breathing": 2, "rainbow": 3, "pulse": 4,
         "rainbowwave": 5, "rainbow-wave": 5, "wave": 6, "star": 7,
         "colorstack": 8, "color-stack": 8}
MODE_NAMES = {0: "off", 1: "on", 2: "breathing", 3: "rainbow", 4: "pulse",
              5: "rainbowwave", 6: "wave", 7: "star", 8: "colorstack"}


def _ioc(direction: int, typ: str, nr: int, size: int) -> int:
    return (direction << 30) | (size << 16) | (ord(typ) << 8) | nr


def HIDIOCSFEATURE(size: int) -> int:
    return _ioc(3, "H", 0x06, size)


def HIDIOCGFEATURE(size: int) -> int:
    return _ioc(3, "H", 0x07, size)


def find_device(explicit: str | None = None) -> str:
    if explicit:
        return explicit
    fallback = []
    for node in sorted(Path("/dev").glob("hidraw*")):
        try:
            uevent = Path(f"/sys/class/hidraw/{node.name}/device/uevent").read_text()
        except OSError:
            continue
        if VENDOR_PRODUCT not in uevent.upper():
            continue
        try:
            desc = Path(
                f"/sys/class/hidraw/{node.name}/device/report_descriptor"
            ).read_bytes()
        except OSError:
            desc = b""
        if b"\x85\x07" in desc:      # this interface carries the LED report
            return str(node)
        fallback.append(node)
    if fallback:
        return str(fallback[0])
    raise SystemExit("no EVGA 3842:300e hidraw device found")


def build_frame(zone: int, mode: int, sub: int = SUB_WRITE) -> bytearray:
    buf = bytearray(BUFLEN)
    buf[0], buf[1], buf[2] = REPORT_ID, HEADER1, HEADER2
    buf[3], buf[4] = MAIN_LIGHT_EFFECT, sub
    buf[8] = zone & 0xFF
    if sub == SUB_WRITE:
        for idx, (_name, bit) in enumerate(ZONE_ORDER):
            if zone & bit:
                buf[9 + idx] = mode & 0xFF
    buf[7] = (-(sum(buf[0:7]) + buf[8] + sum(buf[9:14]))) & 0xFF
    return buf


def _open(path: str) -> int:
    try:
        return os.open(path, os.O_RDWR | os.O_CLOEXEC)
    except PermissionError:
        return -1


def reopen_via_docker(path: str, argv: list[str]) -> int:
    """Run ourselves inside a container so root can open the hidraw node."""
    if not shutil.which("docker"):
        print("permission denied on the hidraw node, and docker is unavailable.",
              file=sys.stderr)
        print('install the rule: SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3842", '
              'ATTRS{idProduct}=="300e", TAG+="uaccess"', file=sys.stderr)
        return 1
    cmd = [
        "docker", "run", "--rm", "--device", path,
        "-v", f"{os.path.realpath(__file__)}:/evga-led:ro",
        "--entrypoint", "/app/.venv/bin/python",
        DOCKER_IMAGE, "/evga-led", "--device", path, *argv,
    ]
    print(f"(using a container for device access: {DOCKER_IMAGE})", file=sys.stderr)
    return subprocess.call(cmd)


def read_state(path: str, tries: int = 4, delay: float = 0.25) -> bytearray | None:
    """GET with no preceding SET: the MCU echoes its last command frame."""
    last = None
    for _ in range(tries):
        fd = _open(path)
        if fd < 0:
            last = "permission denied"
            time.sleep(delay)
            continue
        try:
            buf = bytearray(BUFLEN)
            fcntl.ioctl(fd, HIDIOCGFEATURE(BUFLEN), buf, True)
            return buf
        except OSError as exc:
            last = errno.errorcode.get(exc.errno, str(exc.errno))
            time.sleep(delay)
        finally:
            os.close(fd)
    print(f"read-back unavailable ({last}) — this MCU stalls GET after a SET")
    return None


def do_set(path: str, zone: int, mode: int, dry_run: bool) -> int:
    frame = build_frame(zone, mode)
    if dry_run:
        print(f"zone=0x{zone:02X} mode={mode} checksum=0x{frame[7]:02X}")
        print(frame[:20].hex(" "), f"+ {BUFLEN - 20} reserved bytes")
        return 0

    fd = _open(path)
    if fd < 0:
        return reopen_via_docker(path, sys.argv[1:])
    try:
        fcntl.ioctl(fd, HIDIOCSFEATURE(BUFLEN), frame, True)
    except OSError as exc:
        print(f"SET failed: {errno.errorcode.get(exc.errno, str(exc.errno))}")
        return 1
    finally:
        os.close(fd)

    print(f"sent: zone 0x{zone:02X} -> {MODE_NAMES.get(mode, mode)} "
          f"(checksum 0x{frame[7]:02X})")
    time.sleep(0.4)
    state = read_state(path, tries=2)
    if state is not None:
        print(f"read back: zone=0x{state[8]:02X} modes={list(state[9:14])} "
              f"response={RESPONSE.get(state[6], hex(state[6]))}")
    else:
        print("read back: not available (the command was still applied)")
    return 0


def do_status(path: str) -> int:
    state = read_state(path)
    if state is None:
        return 1
    zones = [name for name, bit in ZONE_ORDER if state[8] & bit]
    print(f"last command: zone=0x{state[8]:02X} ({', '.join(zones) or 'none'}) "
          f"response={RESPONSE.get(state[6], hex(state[6]))}")
    for idx, (name, _bit) in enumerate(ZONE_ORDER):
        print(f"  {name:6} {MODE_NAMES.get(state[9 + idx], state[9 + idx])}")
    return 0


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description="EVGA Z790 onboard ARGB control")
    ap.add_argument("--device", help="hidraw node (default: autodetect)")
    ap.add_argument("action", nargs="?", default="status",
                    choices=["off", "on", "mode", "status", "detect"])
    ap.add_argument("mode", nargs="?", help="mode name for 'mode'")
    ap.add_argument("-z", "--zone", default="all",
                    help="all | onboard | argb1..argb4 (default: all)")
    ap.add_argument("-n", "--dry-run", action="store_true")
    args = ap.parse_args(argv)

    path = find_device(args.device)

    if args.action == "detect":
        print(f"device: {path}")
        try:
            desc = Path(
                f"/sys/class/hidraw/{Path(path).name}/device/report_descriptor"
            ).read_bytes()
            print(f"report id 7 present: {b'\x85\x07' in desc}")
        except OSError as exc:
            print(f"descriptor unreadable here: {exc}")
        return 0

    if args.action == "status":
        return do_status(path)

    zone_key = args.zone.lower()
    if zone_key not in ZONE_ALIASES:
        raise SystemExit(f"unknown zone '{args.zone}': {', '.join(sorted(ZONE_ALIASES))}")
    zone = ZONE_ALIASES[zone_key]

    if args.action in ("off", "on"):
        return do_set(path, zone, MODES[args.action], args.dry_run)

    if not args.mode:
        raise SystemExit("'mode' needs a mode name")
    key = args.mode.lower()
    if key not in MODES:
        raise SystemExit(f"unknown mode '{args.mode}': {', '.join(sorted(MODES))}")
    return do_set(path, zone, MODES[key], args.dry_run)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
